---
// The client portal's front door. Without a session it shows the sign-in form (client code and
// passcode); POST checks them, sets the session cookie and reloads. With a session it shows the
// client's project overview. The client is never part of the URL.
import PortalOverview from '../../components/portal/PortalOverview.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  authConfigured,
  createSession,
  normalizeCode,
  verifyCredentials,
} from '../../lib/portal/auth';
import { rateLimit } from '../../lib/portal/store';

export const prerender = false;

const configured = authConfigured();
let error: string | null = null;
let codeValue = '';

if (Astro.request.method === 'POST' && configured && !Astro.locals.client) {
  let address = 'unknown';
  try {
    address = Astro.clientAddress;
  } catch {
    // Not available in every runtime; the limit then applies to one shared bucket.
  }
  const allowed = await rateLimit(`sign-in:${address}`, 10, 15 * 60);
  if (!allowed) {
    error = 'Too many attempts. Wait fifteen minutes and try again.';
  } else {
    const form = await Astro.request.formData();
    const code = form.get('code');
    const passcode = form.get('passcode');
    codeValue = typeof code === 'string' ? code : '';
    const client =
      typeof code === 'string' && typeof passcode === 'string'
        ? await verifyCredentials(normalizeCode(code), passcode)
        : null;
    if (client) {
      await createSession(Astro.cookies, client.slug);
      return Astro.redirect('/portal/', 303);
    }
    error = 'That client code and passcode did not match. Check them with Jeff and try again.';
  }
}

const client = Astro.locals.client;
---

{client ? (
  <PortalOverview client={client} />
) : (
  <BaseLayout
    title="Client portal"
    description="Private project space for Jeff Newton's consulting clients."
    noindex
  >
    <section class="section" aria-labelledby="sign-in-title">
      <div class="container sign-in">
        <h1 id="sign-in-title">Client portal</h1>
        <p class="lede">
          Private project spaces for consulting clients: discovery notes, design explorations and
          shared files. Sign in with the client code and passcode Jeff gave you.
        </p>

        {configured ? (
          <form method="post" action="/portal/" class="card sign-in-form" novalidate>
            <div class="field">
              <label for="code">Client code</label>
              <input
                id="code"
                name="code"
                type="text"
                autocomplete="username"
                autocapitalize="none"
                spellcheck="false"
                required
                value={codeValue}
                aria-invalid={error ? 'true' : undefined}
              />
            </div>
            <div class="field">
              <label for="passcode">Passcode</label>
              <input
                id="passcode"
                name="passcode"
                type="password"
                autocomplete="current-password"
                required
                aria-describedby={error ? 'sign-in-error' : undefined}
                aria-invalid={error ? 'true' : undefined}
              />
            </div>
            {error && (
              <p id="sign-in-error" class="error" role="alert">
                {error}
              </p>
            )}
            <button class="btn btn-primary" type="submit">
              Sign in
            </button>
          </form>
        ) : (
          <p class="card">
            The portal is not set up on this deployment yet (missing PORTAL_SESSION_SECRET or
            PORTAL_PASSCODES).
          </p>
        )}
      </div>
    </section>
  </BaseLayout>
)}

<style>
  .sign-in {
    max-inline-size: 32rem;
  }

  h1 {
    font-size: var(--text-h2);
    margin-block-end: 0.75rem;
  }

  .lede {
    margin-block-end: 2rem;
  }

  .sign-in-form {
    display: grid;
    gap: 1rem;
  }

  .field {
    display: grid;
    gap: 0.375rem;
  }

  label {
    color: var(--heading);
    font-weight: 600;
  }

  input {
    min-block-size: 2.75rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background-color: var(--bg);
    color: var(--heading);
    font: inherit;
    font-size: var(--text-base);
  }

  input[aria-invalid='true'] {
    border-color: var(--amber);
  }

  .error {
    color: var(--amber);
    font-size: var(--text-sm);
  }

  button {
    justify-self: start;
    margin-block-start: 0.25rem;
  }
</style>
