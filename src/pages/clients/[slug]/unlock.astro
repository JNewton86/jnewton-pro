---
// Passcode gate for a client's portal. GET shows the form; POST checks the passcode, sets the
// session cookie and sends the visitor to the portal. Attempts are rate limited per address.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  authConfigured,
  createSession,
  hasSession,
  verifyPasscode,
} from '../../../lib/portal/auth';
import { rateLimit } from '../../../lib/portal/store';

export const prerender = false;

const client = Astro.locals.client;
if (!client) return new Response(null, { status: 404 });

const home = `/clients/${client.slug}/`;
if (await hasSession(Astro.cookies, client.slug)) return Astro.redirect(home, 303);

const configured = authConfigured();
let error: string | null = null;

if (Astro.request.method === 'POST' && configured) {
  let address = 'unknown';
  try {
    address = Astro.clientAddress;
  } catch {
    // Not available in every runtime; the limit then applies to one shared bucket.
  }
  const allowed = await rateLimit(`unlock:${client.slug}:${address}`, 10, 15 * 60);
  if (!allowed) {
    error = 'Too many attempts. Wait fifteen minutes and try again.';
  } else {
    const form = await Astro.request.formData();
    const attempt = form.get('passcode');
    if (typeof attempt === 'string' && (await verifyPasscode(client.slug, attempt))) {
      await createSession(Astro.cookies, client.slug);
      return Astro.redirect(home, 303);
    }
    error = 'That passcode did not match. Check it with Jeff and try again.';
  }
}
---

<BaseLayout title={`${client.name} portal`} description={client.summary} noindex>
  <section class="section" aria-labelledby="unlock-title">
    <div class="container unlock">
      <p class="client-name">{client.name}</p>
      <h1 id="unlock-title">Project portal</h1>
      <p class="lede">
        {client.project}. Enter the passcode Jeff shared with you to open the discovery board and
        project files.
      </p>

      {configured ? (
        <form method="post" action={`${home}unlock/`} class="card unlock-form" novalidate>
          <label for="passcode">Passcode</label>
          <input
            id="passcode"
            name="passcode"
            type="password"
            autocomplete="current-password"
            required
            aria-describedby={error ? 'unlock-error' : undefined}
            aria-invalid={error ? 'true' : undefined}
          />
          {error && (
            <p id="unlock-error" class="error" role="alert">
              {error}
            </p>
          )}
          <button class="btn btn-primary" type="submit">
            Open portal
          </button>
        </form>
      ) : (
        <p class="card">
          The portal is not set up on this deployment yet (missing PORTAL_SESSION_SECRET or
          PORTAL_PASSCODES).
        </p>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .unlock {
    max-inline-size: 32rem;
  }

  .client-name {
    color: var(--amber);
    font-weight: 600;
    margin-block-end: 0.5rem;
  }

  h1 {
    font-size: var(--text-h2);
    margin-block-end: 0.75rem;
  }

  .lede {
    margin-block-end: 2rem;
  }

  .unlock-form {
    display: grid;
    gap: 0.75rem;
  }

  label {
    color: var(--heading);
    font-weight: 600;
  }

  input {
    min-block-size: 2.75rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background-color: var(--bg);
    color: var(--heading);
    font: inherit;
    font-size: var(--text-base);
  }

  input[aria-invalid='true'] {
    border-color: var(--amber);
  }

  .error {
    color: var(--amber);
    font-size: var(--text-sm);
  }

  button {
    justify-self: start;
    margin-block-start: 0.5rem;
  }
</style>
