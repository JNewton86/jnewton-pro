---
import { Font } from 'astro:assets';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import StructuredData from '../components/StructuredData.astro';
import { OG_HEIGHT, OG_WIDTH } from '../lib/og-image';
import { site } from '../site.config';
import '../styles/global.css';

interface Props {
  /** Page-specific title; the site name is appended. Omit on the home page. */
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  /** Path to this page's link-preview image (generated by src/pages/og/). */
  ogImage?: string;
  /** Alt text for the preview image. */
  ogImageAlt?: string;
  /** schema.org JSON-LD for this page (see src/lib/structured-data.ts). */
  structuredData?: Record<string, unknown>;
  /** Keep the page out of search engines (private pages such as the client portal). */
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  type = 'website',
  ogImage = '/og/home.png',
  ogImageAlt = `${site.name}, ${site.jobTitle}`,
  structuredData,
  noindex = false,
} = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="text-scale" content="scale" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#080d17" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(OG_WIDTH)} />
    <meta property="og:image:height" content={String(OG_HEIGHT)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <Font cssVariable="--font-dm-sans" preload />
    <Font cssVariable="--font-bebas-neue" preload />
    <Font cssVariable="--font-space-mono" />

    {structuredData && <StructuredData data={structuredData} />}
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
