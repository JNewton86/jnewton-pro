---
import type { Role } from '../data/resume';

interface Props {
  items: readonly Role[];
}

const { items } = Astro.props;
---

<!-- A real chronological sequence, so the connecting line and markers carry meaning -->
<ol class="timeline">
  {items.map(({ title, org, detail, start, end, highlights }) => (
    <li class="timeline-item">
      <p class="dates">
        {start} – {end}
      </p>
      <h3 class="role">{title}</h3>
      <p class="org">
        {org}
        {detail && <span class="detail">{detail}</span>}
      </p>
      <ul class="highlights">
        {highlights.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </li>
  ))}
</ol>

<style>
  .timeline {
    position: relative;
    display: grid;
    gap: 3.5rem;
    padding: 0 0 0 1.75rem;
    list-style: none;
  }

  .timeline::before {
    position: absolute;
    inset-block: 0.4rem 0;
    inset-inline-start: 0;
    inline-size: 1px;
    background: linear-gradient(to bottom, var(--cyan), var(--border) 85%, transparent);
    content: '';
  }

  .timeline-item {
    position: relative;
    max-inline-size: 52rem;
    padding-inline-start: 1.5rem;
  }

  .timeline-item::before {
    position: absolute;
    inset-block-start: 0.35rem;
    inset-inline-start: calc(-1.75rem - 5px);
    inline-size: 11px;
    block-size: 11px;
    border: 2px solid var(--cyan);
    border-radius: 50%;
    background-color: var(--bg);
    content: '';
  }

  .dates {
    margin-block-end: 0.375rem;
    color: var(--cyan);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    font-weight: 500;
  }

  .role {
    margin-block-end: 0.375rem;
  }

  .org {
    margin-block-end: 1rem;
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .detail {
    display: block;
  }

  .highlights {
    display: grid;
    gap: 0.5rem;
    padding-inline-start: 1.1rem;
    font-size: 0.9375rem;
  }

  .highlights li::marker {
    color: var(--cyan-dim);
  }
</style>
