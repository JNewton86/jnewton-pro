---
type Status = 'live' | 'wip' | 'concept' | 'active' | 'in-progress' | 'exploring';

interface Props {
  status: Status;
}

const labels: Record<Status, string> = {
  live: 'Live',
  wip: 'In progress',
  concept: 'Concept',
  active: 'Active',
  'in-progress': 'In progress',
  exploring: 'Exploring',
};

// Color encodes state: green = done/live, amber = underway, cyan = idea/exploring.
const tone: Record<Status, 'done' | 'underway' | 'idea'> = {
  live: 'done',
  active: 'done',
  wip: 'underway',
  'in-progress': 'underway',
  concept: 'idea',
  exploring: 'idea',
};

const { status } = Astro.props;
---

<span class:list={['status', tone[status]]}>{labels[status]}</span>

<style>
  .status {
    display: inline-block;
    padding: 0.125rem 0.5rem;
    border: 1px solid;
    border-radius: var(--radius);
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: 1.5;
  }

  .done {
    border-color: rgb(74 222 128 / 0.35);
    background-color: rgb(74 222 128 / 0.1);
    color: var(--green);
  }

  .underway {
    border-color: rgb(240 160 48 / 0.35);
    background-color: rgb(240 160 48 / 0.1);
    color: var(--amber);
  }

  .idea {
    border-color: rgb(0 207 195 / 0.35);
    background-color: rgb(0 207 195 / 0.1);
    color: var(--cyan);
  }
</style>
