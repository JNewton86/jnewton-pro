---
// Shell for the signed-in client portal pages: page title, client name, section tabs, sign out.
import type { ClientPortal } from '../../data/clients';
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Props {
  client: ClientPortal;
  /** Which portal section this page is; sets the current tab and the browser title. */
  section: 'overview' | 'discovery' | 'files';
  title: string;
  lede?: string;
}

const { client, section, title, lede } = Astro.props;
const base = `/clients/${client.slug}/`;
const tabs = [
  { id: 'overview', label: 'Overview', href: base },
  { id: 'discovery', label: 'Discovery board', href: `${base}discovery/` },
  { id: 'files', label: 'Files', href: `${base}files/` },
] as const;
---

<BaseLayout title={`${title} (${client.name})`} description={client.summary} noindex>
  <section class="section portal" aria-labelledby="portal-title">
    <div class="container">
      <header class="portal-head">
        <p class="client-name">{client.name}</p>
        <h1 id="portal-title">{title}</h1>
        {lede && <p class="lede">{lede}</p>}
      </header>

      <div class="portal-bar">
        <nav aria-label="Portal sections">
          <ul class="portal-tabs">
            {tabs.map((tab) => (
              <li>
                <a href={tab.href} aria-current={tab.id === section ? 'page' : undefined}>
                  {tab.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <form method="post" action={`${base}logout/`}>
          <button class="btn btn-ghost sign-out" type="submit">
            Sign out
          </button>
        </form>
      </div>

      <slot />
    </div>
  </section>
</BaseLayout>

<style>
  .portal {
    padding-block-start: clamp(2.5rem, 2rem + 2vw, 4rem);
  }

  .portal-head {
    margin-block-end: 2rem;
  }

  .client-name {
    color: var(--amber);
    font-weight: 600;
    margin-block-end: 0.5rem;
  }

  h1 {
    font-size: var(--text-h2);
    margin-block-end: 0.75rem;
  }

  .lede {
    max-inline-size: var(--prose-max);
  }

  .portal-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-block-end: 2.5rem;
    padding-block-end: 0.75rem;
    border-block-end: 1px solid var(--border);
  }

  .portal-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    padding: 0;
    list-style: none;
  }

  .portal-tabs a {
    display: inline-block;
    padding-block: 0.5rem;
    border-block-end: 2px solid transparent;
    color: var(--text);
    font-weight: 500;
    text-decoration: none;
  }

  .portal-tabs a:hover {
    color: var(--cyan);
  }

  .portal-tabs a[aria-current='page'] {
    border-block-end-color: var(--cyan);
    color: var(--heading);
  }

  .sign-out {
    min-block-size: 2.25rem;
    padding-block: 0.375rem;
    font-size: var(--text-sm);
  }
</style>
