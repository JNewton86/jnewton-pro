---
import { credentials } from '../data/resume';
import { site } from '../site.config';
import TerminalCard from './TerminalCard.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-copy">
      <h1 id="hero-title" class="hero-name rise">
        <span>Jeff</span>
        <span>Newton</span>
      </h1>
      <p class="hero-role rise">
        Technical product manager and applied AI developer in {site.location}.
      </p>
      <p class="lede rise">
        15+ years across mortgage lending, fintech, and cloud-native software delivery. I translate
        business, regulatory, and operational requirements into clear technical roadmaps,
        well-defined user stories, and scalable system designs — with hands-on engineering
        experience to back it up.
      </p>
      <ul class="credentials rise" aria-label="Credentials and platforms">
        {credentials.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
      <div class="actions rise">
        <a class="btn btn-primary" href="#work">
          See my work
        </a>
        <a class="btn btn-secondary" href={site.resume} download>
          Download résumé (PDF)
        </a>
        <a class="btn btn-ghost" href={site.social.github.url} rel="me">
          GitHub
        </a>
      </div>
    </div>
    <div class="hero-terminal rise">
      <TerminalCard />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3.5rem, 2rem + 6vw, 7rem);
  }

  .hero-grid {
    display: grid;
    gap: clamp(2.5rem, 1rem + 4vw, 4.5rem);
    align-items: center;
  }

  @media (width >= 64rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 28rem);
    }
  }

  .hero-copy {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  .hero-name {
    line-height: 0.9;
  }

  .hero-name span {
    display: block;
  }

  .hero-role {
    color: var(--cyan);
    font-size: var(--text-lg);
    font-weight: 500;
  }

  .hero-copy .lede {
    max-inline-size: 34rem;
  }

  .credentials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }

  .credentials li {
    padding: 0.25rem 0.625rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    color: var(--amber);
    font-size: var(--text-xs);
    font-weight: 500;
  }

  .actions {
    margin-block-start: 0.5rem;
  }

  /* The page's one orchestrated motion: a short staggered load sequence.
     Without a motion preference (or with reduce), everything is simply visible. */
  @media (prefers-reduced-motion: no-preference) {
    .rise {
      animation: rise 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }

    .hero-copy > :nth-child(2) {
      animation-delay: 0.08s;
    }
    .hero-copy > :nth-child(3) {
      animation-delay: 0.16s;
    }
    .hero-copy > :nth-child(4) {
      animation-delay: 0.24s;
    }
    .hero-copy > :nth-child(5) {
      animation-delay: 0.32s;
    }
    .hero-terminal {
      animation-delay: 0.4s;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      translate: 0 1rem;
    }
  }
</style>
