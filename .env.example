# Client portal (src/lib/portal). All optional: without them the public site builds and runs
# unchanged, and /portal/ reports that it isn't configured.

# Signing key for portal session cookies. At least 32 random characters, e.g. `openssl rand -base64 32`.
PORTAL_SESSION_SECRET=

# Passcodes per client code (the slugs in src/data/clients), as a JSON object. Visitors type the
# code and passcode at /portal/.
PORTAL_PASSCODES={"aaplus":"change-me"}

# Upstash Redis via the Vercel Marketplace (stores discovery-board notes and the unlock rate limit).
# The integration injects these automatically on Vercel; copy them here for local development.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Vercel Blob (private store) for files shared through the portal, under clients/<slug>/<name>.
BLOB_READ_WRITE_TOKEN=
